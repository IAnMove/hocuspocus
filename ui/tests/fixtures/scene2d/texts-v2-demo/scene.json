{
  "version": 1,
  "name": "texts-v2-demo",
  "width": 1280,
  "height": 720,
  "fps": 24,
  "duration": 4,
  "texts": [
    { "id": "sans", "text": "Sans", "start": 0, "end": 4, "preset": "impact", "x": 18, "y": 22, "size": 8, "color": "#ffe3a0", "rotation": 0, "font": "sans" },
    { "id": "mono", "text": "Mono", "start": 0, "end": 4, "preset": "typewriter", "x": 40, "y": 22, "size": 7, "color": "#d7ecff", "rotation": 0, "font": "mono" },
    { "id": "display", "text": "DISPLAY", "start": 0, "end": 4, "preset": "impact", "x": 68, "y": 22, "size": 9, "color": "#fff6e8", "rotation": 0, "font": "display", "weight": 400, "enter": { "preset": "impact", "duration": 0.5 } },
    { "id": "condensed", "text": "CONDENSED", "start": 0, "end": 4, "preset": "rise", "x": 18, "y": 48, "size": 7, "color": "#ffd0a8", "rotation": 0, "font": "condensed", "enter": { "preset": "rise", "duration": 0.6 } },
    { "id": "serif", "text": "Serif", "start": 0, "end": 4, "preset": "impact", "x": 42, "y": 48, "size": 8, "color": "#f7efe2", "rotation": 0, "font": "serif", "italic": true, "enter": { "preset": "fade", "duration": 0.5 } },
    { "id": "hand", "text": "Hand", "start": 0, "end": 4, "preset": "wave", "x": 66, "y": 48, "size": 8, "color": "#ffe0b0", "rotation": -4, "font": "hand", "enter": { "preset": "letters", "duration": 1.2 } },
    { "id": "marker", "text": "Marker line", "start": 0, "end": 4, "preset": "impact", "x": 50, "y": 72, "size": 8, "color": "#2a2118", "rotation": 0, "font": "marker", "enter": { "preset": "words", "duration": 1.1 }, "box": { "kind": "paper", "color": "#f4e7cf", "opacity": 0.94, "padding": 0.45 } },
    { "id": "count", "text": "{value}", "start": 0, "end": 4, "preset": "impact", "x": 84, "y": 72, "size": 10, "color": "#ffffff", "rotation": 0, "font": "display", "weight": 400, "counter": { "from": 1990, "to": 2000, "decimals": 0, "ease": "ease" } }
  ],
  "layers": [
    {
      "id": "plate",
      "name": "Plate",
      "type": "effect",
      "visible": true,
      "z": 0,
      "transform": { "x": 50, "y": 50, "scale": 1, "opacity": 1, "rotation": 0 },
      "animation": {
        "start": { "x": 50, "y": 50, "scale": 1, "opacity": 1, "rotation": 0 },
        "end": { "x": 50, "y": 50, "scale": 1, "opacity": 1, "rotation": 0 },
        "duration": 4,
        "curve": "linear"
      }
    }
  ]
}

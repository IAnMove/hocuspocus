{
 "version": 1,
 "note": "What a screen effect lasts and how big it is when a Series script gives no duration or size (services/series_fx_classes.py). Every effect of scene_effects.json is classified here; tests/test_series_shot_extras.py checks it. A value the script gives always wins.",
 "classes": {
  "presence": {
   "what": "Continuous or atmospheric: an aura, a shield, light, weather, smoke, a screen grade. Lasts the whole shot unless the script says otherwise.",
   "duration": "shot"
  },
  "hit": {
   "what": "A moment: an impact, a burst, a flash, a wave, a beam. Lasts `duration` seconds of its own (0.25-1).",
   "duration": 1
  }
 },
 "sizes": {
  "note": "`size` of an effect is % of the frame's shorter side. `cover`: a presence effect that fills a place: it covers the subject (the cue names a cast member or gives x/y; per framing) or, with neither, the whole screen. `framing`: an object or a hit, proportioned to the framing. `own`: size means something else for this effect (drop size, glyph height, pattern height, a clear circle) or the effect fills the frame: the default is left alone. `scale` multiplies the table value (capped at 200) for effects that draw small inside their box.",
  "cover": {
   "screen": 178,
   "subject": {
    "wide": 80,
    "two": 125,
    "medium": 190,
    "close": 200,
    "default": 125
   }
  },
  "framing": {
   "wide": 65,
   "two": 80,
   "medium": 100,
   "close": 120,
   "default": 80
  }
 },
 "warning": {
  "code": "fx_presence_too_short",
  "belowSeconds": 2,
  "inShotsLongerThanSeconds": 4
 },
 "effects": {
  "sparks": {"class": "hit", "size": "framing", "duration": 0.8, "scale": 1.5},
  "explosion": {"class": "hit", "size": "framing", "duration": 1},
  "fireworks": {"class": "hit", "size": "framing", "duration": 1, "scale": 1.4},
  "confetti": {"class": "hit", "size": "framing", "duration": 1, "scale": 1.3},
  "rain": {"class": "presence", "size": "own"},
  "snow": {"class": "presence", "size": "own"},
  "embers": {"class": "presence", "size": "cover"},
